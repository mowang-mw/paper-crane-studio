# AnimeFlow M3 本地配置示例。项目不会自动加载本文件；请按 README 在当前
# PowerShell 进程设置需要覆盖的环境变量。不要把真实密钥写入仓库。

# 平台
SCRIPT_PROVIDER=mock
ANIME_PLATFORM_DATA_DIR=data
ANIME_PLATFORM_WORKER_POLL_SECONDS=1
ANIME_PLATFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# llama.cpp / Qwen3-4B-GGUF（M3 已验证的官方制品）
LLAMA_SERVER_BIN=tools/llama.cpp/llama-server.exe
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8081
LLAMA_MODEL_PATH=models/text/Qwen3-4B-Q4_K_M.gguf
LLAMA_MODEL_ID=Qwen3-4B-Q4_K_M.gguf
LLAMA_MODEL_SHA256=7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5
LLAMA_SERVER_VERSION=b10189-b2f221684
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=99
LLAMA_TIMEOUT_SECONDS=180
LLAMA_HEALTH_TIMEOUT_SECONDS=2
LLAMA_TEMPERATURE=0.1
LLAMA_TOP_P=0.9
LLAMA_MAX_TOKENS=4096
LLAMA_PROMPT_VERSION=script-v1-qwen3-nonthinking-v3
