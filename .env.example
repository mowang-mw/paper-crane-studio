# Copy this file to .env for local development. Keep real credentials out of Git.

# Core application (Mock providers are the safe default.)
ANIME_PLATFORM_DATA_DIR=data
ANIME_PLATFORM_WORKER_POLL_SECONDS=1
ANIME_PLATFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SCRIPT_PROVIDER=mock
IMAGE_PROVIDER=mock
AUDIO_PROVIDER=mock
ANIME_PLATFORM_DATABASE_URL=

# Media tools. Leave blank when ffmpeg and ffprobe are already on PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# Optional local text provider: Qwen3-4B served by llama.cpp.
LLAMA_SERVER_BIN=tools/llama.cpp/llama-server.exe
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8081
LLAMA_MODEL_PATH=models/text/Qwen3-4B-Q4_K_M.gguf
LLAMA_MODEL_ID=Qwen3-4B-Q4_K_M.gguf
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=99
LLAMA_TIMEOUT_SECONDS=180
LLAMA_HEALTH_TIMEOUT_SECONDS=2
LLAMA_STARTUP_TIMEOUT_SECONDS=120
LLAMA_TEMPERATURE=0.1
LLAMA_TOP_P=0.9
LLAMA_MAX_TOKENS=4096

# Optional local image provider: Animagine XL 4.0 through ComfyUI.
COMFYUI_PYTHON=.venv-comfyui/Scripts/python.exe
COMFYUI_ROOT=tools/ComfyUI
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_MODEL_PATH=models/image/animagine-xl-4.0-opt.safetensors
COMFYUI_MODEL_ID=cagliostrolab/animagine-xl-4.0
COMFYUI_STARTUP_TIMEOUT_SECONDS=240
COMFYUI_IMAGE_TIMEOUT_SECONDS=600
COMFYUI_JOB_TIMEOUT_SECONDS=3600
COMFYUI_HTTP_TIMEOUT_SECONDS=30
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
IMAGE_STEPS=24
IMAGE_CFG=5
IMAGE_SAMPLER=euler_ancestral
IMAGE_SCHEDULER=normal
IMAGE_BASE_SEED=0

# Optional local speech provider: Qwen3-TTS in its dedicated environment.
QWEN_TTS_PYTHON=.venv-qwen3-tts/python.exe
QWEN_TTS_RUNNER=scripts/qwen3_tts_job_runner.py
QWEN_TTS_MODEL_PATH=models/audio/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_DEFAULT_SPEAKER=Serena
QWEN_TTS_LANGUAGE=Chinese
QWEN_TTS_MODEL_LOAD_TIMEOUT_SECONDS=300
QWEN_TTS_SHOT_TIMEOUT_SECONDS=300
QWEN_TTS_JOB_TIMEOUT_SECONDS=1200
QWEN_TTS_GPU_RELEASE_TIMEOUT_SECONDS=60
AUDIO_GPU_HANDOFF_MAX_USED_MIB=2048
AUDIO_LEAD_IN_SECONDS=0.20
AUDIO_LEAD_OUT_SECONDS=0.35
AUDIO_RENDERED_MAX_SECONDS=60

# Optional Cloud Wan 2.7 video provider. These values are intentionally blank.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
CLOUD_WAN_MODEL_ID=wan2.7-i2v-2026-04-25
CLOUD_WAN_POLL_INTERVAL_SECONDS=15
CLOUD_WAN_TIMEOUT_SECONDS=1800
CLOUD_WAN_HTTP_TIMEOUT_SECONDS=30
CLOUD_WAN_MAX_SOURCE_IMAGE_BYTES=10485760

# Frontend development server.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
