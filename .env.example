# AnimeFlow M4-B 本地配置示例。项目不会自动加载本文件；请按 README 在当前
# PowerShell 进程设置需要覆盖的环境变量。不要把真实密钥写入仓库。

# 平台
SCRIPT_PROVIDER=mock
ANIME_PLATFORM_DATA_DIR=data
ANIME_PLATFORM_WORKER_POLL_SECONDS=1
ANIME_PLATFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IMAGE_PROVIDER=mock

# llama.cpp / Qwen3-4B-GGUF（M3 已验证的官方制品）
LLAMA_SERVER_BIN=tools/llama.cpp/llama-server.exe
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8081
LLAMA_MODEL_PATH=models/text/Qwen3-4B-Q4_K_M.gguf
LLAMA_MODEL_ID=Qwen3-4B-Q4_K_M.gguf
LLAMA_MODEL_SHA256=7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5
LLAMA_SERVER_VERSION=b10189-b2f221684
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=99
LLAMA_TIMEOUT_SECONDS=180
LLAMA_HEALTH_TIMEOUT_SECONDS=2
LLAMA_TEMPERATURE=0.1
LLAMA_TOP_P=0.9
LLAMA_MAX_TOKENS=4096
LLAMA_PROMPT_VERSION=script-v1-qwen3-nonthinking-v3

# ComfyUI / Animagine XL 4.0 Opt（M4-A 独立环境；不得安装进 anime-platform）
COMFYUI_PYTHON=.venv-comfyui/Scripts/python.exe
COMFYUI_ROOT=tools/ComfyUI
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_MODEL_PATH=models/image/animagine-xl-4.0-opt.safetensors
COMFYUI_MODEL_ID=cagliostrolab/animagine-xl-4.0
COMFYUI_MODEL_SHA256=6327eca98bfb6538dd7a4edce22484a1bbc57a8cff6b11d075d40da1afb847ac
COMFYUI_MODEL_LICENSE=CreativeML Open RAIL++-M
COMFYUI_EXPECTED_COMMIT=f06a187f50f896e4a0ba5be1ce1f2d2dcd13b77b
COMFYUI_STARTUP_TIMEOUT_SECONDS=240
COMFYUI_IMAGE_TIMEOUT_SECONDS=600
COMFYUI_JOB_TIMEOUT_SECONDS=3600
COMFYUI_HTTP_TIMEOUT_SECONDS=30
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
IMAGE_STEPS=24
IMAGE_CFG=5
IMAGE_SAMPLER=euler_ancestral
IMAGE_SCHEDULER=normal
IMAGE_BASE_SEED=20260802
